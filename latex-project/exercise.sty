% Metadata commands and header builder.
% These are placeholder defaults — override them per group via the bot's /konfig
% command or the .env file (GROUP_NUMBER/COURSE/TUTORIUM/AUTHORS), or edit them here.
\newcommand{\exerciseCourse}{Course Name}
\newcommand{\exerciseGroup}{Tutorium 00}
\newcommand{\exerciseAuthors}{
    Anna Muster, 111111\\
    Ben Beispiel, 222222}

\renewcommand{\exerciseTitle}{Blatt \ExerciseSheet}
% Leave empty so you can override per file
% \newcommand{\exerciseTitle}{}

\newcommand{\exerciseMakeHeaders}{%
  \ihead{\exerciseCourse\\\exerciseGroup\\\today}%
  \chead{\Large \exerciseTitle}%
  \ohead{\exerciseAuthors}%
  \cfoot*{\pagemark}%
}
