% exercise.sty
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{exercise}

\newcommand{\ExerciseGroup}{000} % <-- set your group number here
\newcommand{\ExerciseSheet}{??} % will be set in each .tex file

\newcommand{\setExerciseSheet}[1]{%
  \renewcommand{\ExerciseSheet}{#1}%
}

% output format Gruppe_XXX_Blatt_YY.pdf
\newcommand{\ExercisePdfName}{%
  Gruppe_\ExerciseGroup_Blatt_\ExerciseSheet
}

% Core layout
% \RequirePackage[a4paper,left=1.5cm,right=1.5cm,top=2cm,bottom=2cm]{geometry} % mlds
\RequirePackage[a4paper, left=2cm, right=4.5cm, top=2cm, bottom=2cm]{geometry} % kleinere Ränder
\RequirePackage[headsepline]{scrlayer-scrpage}
\RequirePackage{placeins}
\setlength{\headheight}{3\baselineskip}

% Page style
\pagestyle{scrheadings}
\clearpairofpagestyles
\setlength{\parindent}{0pt}
\setkomafont{pagehead}{\sffamily\upshape}

% Hyperref
\RequirePackage{hyperref}
\hypersetup{
  colorlinks,
  pdfpagelabels,
  pdfstartview=FitH,
  bookmarksopen=true,
  bookmarksnumbered=true,
  linkcolor=black,
  plainpages=false,
  hypertexnames=false,
  citecolor=black
}

% Language + encoding
% If you use LuaLaTeX/XeLaTeX, do NOT load inputenc.
\RequirePackage[utf8]{inputenc}
% Language toggle: keep exactly one of the two lines below uncommented.
% Default is German (ngerman); switch to English by swapping which line is active.
% \RequirePackage[english]{babel}
\RequirePackage[ngerman]{babel}

% Math and typography
\RequirePackage{amsmath,mathtools,amssymb,microtype,enumitem,multicol,booktabs}
\RequirePackage{xspace}
\RequirePackage{tikz}
\usetikzlibrary{arrows,calc}
\RequirePackage{xcolor}

% Shortcuts
\newcommand{\NN}{\mathbb N}
\newcommand{\RR}{\mathbb R}
\newcommand{\QQ}{\mathbb Q}
\newcommand{\ZZ}{\mathbb Z}

% Complexity
\newcommand{\pc}{\ensuremath{{\sf P}}}
\newcommand{\np}{\ensuremath{{\sf NP}}}
\newcommand{\npc}{\ensuremath{{\sf NPC}}}
\newcommand{\pspace}{\ensuremath{{\sf PSPACE}}}
\newcommand{\exptime}{\ensuremath{{\sf EXPTIME}}}
\newcommand{\CClassNP}{\textup{NP}\xspace}
\newcommand{\CClassP}{\textup{P}\xspace}

% Preferences
\renewcommand{\phi}{\varphi}
\renewcommand{\theta}{\vartheta}
\renewcommand{\labelenumi}{(\roman{enumi})}

