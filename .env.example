# lateXercise bot configuration. Copy to .env and fill in.
# .env is gitignored — never commit real secrets.

# --- required ---
# NOTE: keep these comments ABOVE the key. python-dotenv treats a trailing "# ..." on an
# EMPTY value as part of the value, so an inline comment on a blank required field would be
# misread (e.g. GUILD_ID would parse to "# int" instead of being detected as missing).

# bot token from the Developer Portal (secret)
DISCORD_TOKEN=
# int — the guild (server) ID, for guild-scoped command sync
GUILD_ID=
# Comma-separated list of text channel IDs the bot operates in, one per submission group,
# e.g. 111,222,333. At least one is required; each channel is an independent group with its
# own sheets, picks, and /konfig config. The old singular ALLOWED_CHANNEL_ID still works as a
# backward-compatible alias (merged in if both are set).
ALLOWED_CHANNEL_IDS=

# --- paths ---
# root of the LaTeX project (the folder containing exercise.sty)
LATEX_PROJECT_DIR=./latex-project
# SQLite database file
DB_PATH=./data/latexercise.sqlite3

# --- optional ---
# (Comments stay ABOVE each key: a trailing "# ..." on an EMPTY value like `TEX_CMD=`
#  would be parsed as the value itself, not as a comment.)

# Override the compiler with an absolute path, e.g. /Library/TeX/texbin/latexmk.
# Leave blank to auto-detect latexmk/pdflatex on PATH. Useful under launchd/systemd
# where PATH is minimal. DO NOT put a comment after the "=" on this line.
TEX_CMD=
# Downscale the longest image side to this many px before placing (requires Pillow).
# Leave blank to disable.
DOWNSCALE_MAX_PX=2000
# Post a public confirmation in the thread when someone runs /pick (true/false).
ANNOUNCE_PICKS=true

# --- header defaults (optional; global, can also be set live via /konfig per channel) ---
# These fill the PDF header and filename WITHOUT editing exercise.sty. Leave any blank
# to keep exercise.sty's own default. The /konfig command overrides these per channel at
# runtime (precedence: /konfig > .env > exercise.sty).

# Group number — appears in the header and the filename Gruppe_<GROUP_NUMBER>_Blatt_NN.pdf.
# Letters/digits only.
GROUP_NUMBER=
# Course / lecture name shown in the header, e.g. "Mein Kurs SoSe 2026".
COURSE=
# Tutorial / group label shown in the header, e.g. "Tutorium 12".
TUTORIUM=
# Author list for the header, entries separated by ';' (each becomes one line),
# e.g. "Anna Muster, 111111; Ben Test, 222222".
AUTHORS=
